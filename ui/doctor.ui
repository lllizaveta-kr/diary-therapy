QDateEdit::drop-down { border: none; width: 24px; }
QTableWidget { background-color: #FFFFFF; color: #1A1A1A; gridline-color: #EEEEEE; font-family: "Times New Roman"; font-size: 13px; border: 1px solid #CCCCCC; border-radius: 12px; }
QTableWidget::item { color: #1A1A1A; background-color: #FFFFFF; padding: 8px; }
QTableWidget::item:selected { background-color: #7A9CC6; color: #FFFFFF; }
QHeaderView::section { background-color: #2F5C8F; color: #FFFFFF; padding: 10px; border: none; font-family: "Times New Roman"; font-size: 13px; font-weight: bold; }
QStackedWidget > QWidget { background-color: #EEF3F8; }
QListWidget { background-color: #FFFFFF; color: #1A1A1A; border: 1px solid #CCCCCC; border-radius: 10px; font-family: "Times New Roman"; font-size: 13px; padding: 4px; }
QListWidget::item { padding: 8px; border-radius: 6px; }
QListWidget::item:selected { background-color: #7A9CC6; color: #FFFFFF; }
QListWidget::item:hover { background-color: #E8EFF8; }
QPushButton { outline: none; }
