   <string notr="true">QMainWindow { background-color: #EEF3F8; }
QLabel { color: #1A1A1A; background-color: transparent; }
QLineEdit { background-color: #FFFFFF; color: #1A1A1A; border: 1px solid #CCCCCC; border-radius: 10px; padding: 10px 14px; font-family: "Times New Roman"; font-size: 13px; }
QLineEdit::placeholder { color: #999999; }
QLineEdit:focus { border: 2px solid #2F5C8F; }
QTextEdit { background-color: #FFFFFF; color: #1A1A1A; border: 1px solid #CCCCCC; border-radius: 10px; padding: 10px 14px; font-family: "Times New Roman"; font-size: 13px; }
QTextEdit::placeholder { color: #999999; }
QComboBox { background-color: #FFFFFF; color: #1A1A1A; border: 1px solid #CCCCCC; border-radius: 10px; padding: 10px 14px; font-family: "Times New Roman"; font-size: 13px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #1A1A1A; selection-background-color: #7A9CC6; selection-color: #FFFFFF; border: 1px solid #CCCCCC; }
QTableWidget { background-color: #FFFFFF; color: #1A1A1A; gridline-color: #EEEEEE; font-family: "Times New Roman"; font-size: 13px; border: 1px solid #CCCCCC; border-radius: 12px; }
QTableWidget::item { color: #1A1A1A; background-color: #FFFFFF; padding: 8px; }
QTableWidget::item:selected { background-color: #7A9CC6; color: #FFFFFF; }
QHeaderView::section { background-color: #2F5C8F; color: #FFFFFF; padding: 10px; border: none; font-family: "Times New Roman"; font-size: 13px; font-weight: bold; }
QStackedWidget > QWidget { background-color: #EEF3F8; }
QCheckBox { color: #1A1A1A; font-family: "Times New Roman"; font-size: 13px; spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #2F5C8F; border-radius: 4px; background-color: #FFFFFF; }
QCheckBox::indicator:checked { background-color: #2F5C8F; }
QSlider::groove:horizontal { height: 8px; background: #D6E3F3; border-radius: 4px; }
QSlider::handle:horizontal { background: #2F5C8F; width: 20px; margin: -7px 0; border-radius: 10px; }
QSlider::sub-page:horizontal { background: #2F5C8F; border-radius: 4px; }
QPushButton { outline: none; }
QPushButton:focus { outline: none; }</string>
