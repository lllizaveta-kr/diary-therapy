            <property name="readOnly"><bool>true</bool></property>
            <property name="styleSheet"><string notr="true">QTextEdit { background-color: #FFFFFF; color: #1A1A1A; border: 1px solid #CCCCCC; border-radius: 10px; padding: 16px; font-family: "Times New Roman"; font-size: 13px; }</string></property>
            <property name="html"><string>&lt;h2 style="color:#2F5C8F;"&gt;Личный кабинет пациента&lt;/h2&gt;&lt;p&gt;&lt;b&gt;Главная&lt;/b&gt; — приветствие и лекарства на сегодня.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Мои назначения&lt;/b&gt; — план лечения от врача.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Дневник самочувствия&lt;/b&gt; — ежедневная запись состояния, симптомов, показателей.&lt;/p&gt;&lt;p&gt;&lt;b&gt;История записей&lt;/b&gt; — все прошлые записи.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Мой профиль&lt;/b&gt; — ваши данные и лечащий врач.&lt;/p&gt;&lt;h3 style="color:#2F5C8F;"&gt;Горячие клавиши&lt;/h3&gt;&lt;p&gt;&lt;b&gt;F1&lt;/b&gt; — справка&lt;br&gt;&lt;b&gt;Ctrl+Q&lt;/b&gt; — выйти&lt;/p&gt;</string></property>
           </widget></item>
          </layout>
